// Schéma Prisma V2 — CRM Medijob (SPEC_V2 §3).
// Prisma uniquement consommé via src/server/db/repositories/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum UserRole {
  DIRECTION
  RECRUTEUR
  COMMUNICATION
  RH_ADMIN
}

enum PharmacyStatus {
  PROSPECT
  ACTIF
  INACTIF
}

enum CandidateStatus {
  NOUVEAU
  A_QUALIFIER
  QUALIFIE
  EN_MISSION
  INACTIF
  BLACKLISTE
}

enum CandidateOrigin {
  CRM
  APP
}

enum WeeklyAvailabilityPeriod {
  AM
  PM
}

enum ContractType {
  CDI
  CDD
  INTERIM
  VACATION
}

enum MissionStatus {
  A_POURVOIR
  EN_RECHERCHE
  CANDIDATS_PRESENTES
  ENTRETIEN_EN_COURS
  POURVU
  ANNULEE
}

enum ActivityType {
  APPEL
  EMAIL
  ENTRETIEN
  MISSION
  NOTE
  ACTION_COMMERCIALE
  DEVIS
  AUTRE
}

enum DocumentCategory {
  CONTRAT
  DEVIS
  FACTURE
  CONVENTION
  AUTRE
  CNI
  RIB
  DIPLOME
}

enum DocumentEntityType {
  PHARMACY
  CONTACT
  MISSION
  CANDIDATE
}

enum ConsentSource {
  SITE
  MANUAL
  IMPORT
}

enum ApplicationStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum AppProfileStatus {
  EN_ATTENTE
  ACCEPTE
  IGNORE
  APP_VALIDATED
}

enum JobOfferStatus {
  BROUILLON
  PUBLIEE
  DEPUBLIEE
}

enum InterviewStatus {
  DRAFT
  CLOSED
}

enum InterviewMode {
  INTERIM
  CDD_CDI
}

enum InterviewDecision {
  ELIGIBLE
  NON_ELIGIBLE
  REVIEW
}

enum DevisKind {
  INTERIM
  CDD
  CDI
}

enum DevisStatus {
  DRAFT
  SENT
  ACCEPTED
}

enum DevisHtSource {
  ENGINE
  TYPED
}

enum FinanceLineKind {
  PLACEMENT
  INTERIM
}

// ─── Auth (NextAuth v5) ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      UserRole  @default(RECRUTEUR)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  referents       Candidate[]      @relation("ReferentCandidates")
  missionRefs     Mission[]        @relation("ReferentMissions")
  pharmacyRefs    Pharmacy[]       @relation("ReferentPharmacies")
  contactRefs     Contact[]        @relation("ReferentContacts")
  activities      ActivityLog[]
  gdprErases      GdprEraseAudit[]
  interviewRefs   Interview[]      @relation("ReferentInterviews")
  financeLineRefs FinanceLine[]    @relation("ReferentFinanceLines")
  accounts        Account[]
  sessions        Session[]

  @@index([deletedAt])
}

// ─── Référentiels administrables ──────────────────────────────

model Software {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  candidates CandidateSoftware[]
  pharmacies Pharmacy[]
}

model Groupement {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  pharmacies Pharmacy[]
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missionCandidates MissionCandidate[]

  @@index([position])
}

model JobTitle {
  id         String   @id @default(cuid())
  name       String   @unique
  profileKey String?  @unique
  createdAt  DateTime @default(now())

  candidates                Candidate[]
  missions                  Mission[]
  applications              Application[]
  appProfiles               AppProfile[]
  missionCompatibilities    JobTitleCompatibility[] @relation("MissionJobTitle")
  acceptedInCompatibilities JobTitleCompatibility[] @relation("AcceptedCandidateJobTitle")
}

model ContactRole {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  contacts Contact[]
}

// Singleton Admin — monthly CA/Marge per pole + rentability threshold.
model Objectif {
  id                          String   @id
  monthlyCaPlacement          Float
  monthlyMargePlacement       Float
  monthlyCaInterim            Float
  monthlyMargeInterim         Float
  monthlyRentabilityThreshold Float
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model JobTitleCompatibility {
  missionJobTitleId   String
  candidateJobTitleId String
  score               Int    @default(100)

  missionJobTitle   JobTitle @relation("MissionJobTitle", fields: [missionJobTitleId], references: [id], onDelete: Cascade)
  candidateJobTitle JobTitle @relation("AcceptedCandidateJobTitle", fields: [candidateJobTitleId], references: [id], onDelete: Cascade)

  @@id([missionJobTitleId, candidateJobTitleId])
}

// ─── Candidates ───────────────────────────────────────────────

model Candidate {
  id                 String          @id @default(cuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  address            String?
  city               String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  jobTitleId         String
  origin             CandidateOrigin @default(CRM)
  badakanId          String?         @unique
  status             CandidateStatus @default(NOUVEAU)
  statusBeforeInactive CandidateStatus?
  salaryExpectations String?
  salaryMin          Int?
  salaryMax          Int?
  mobilityRadiusKm   Int?
  mobilityNotes      String?
  availableFrom      DateTime?
  cvUrl              String?
  nir                String?
  iban               String?
  cvSummary          String?
  anonymizedProfile  String?
  notes              String?
  consentGivenAt     DateTime?
  consentSource      ConsentSource?
  referentId         String?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  referent                User?                         @relation("ReferentCandidates", fields: [referentId], references: [id], onDelete: SetNull)
  jobTitle                JobTitle                      @relation(fields: [jobTitleId], references: [id])
  softwares               CandidateSoftware[]
  contractPreferences     CandidateContractPreference[]
  missions                MissionCandidate[]
  activities              ActivityLog[]                 @relation("CandidateActivities")
  documents               Document[]                    @relation("CandidateDocuments")
  financeLines            FinanceLine[]
  applications            Application[]
  appProfiles             AppProfile[]
  interviews              Interview[]
  weeklyAvailabilityToken WeeklyAvailabilityToken?
  weeklyAvailabilityWeeks WeeklyAvailabilityWeek[]

  @@index([deletedAt])
  @@index([jobTitleId])
  @@index([referentId])
  @@index([status])
  @@index([origin])
}

model CandidateContractPreference {
  candidateId  String
  contractType ContractType

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([candidateId, contractType])
}

model CandidateSoftware {
  candidateId String
  softwareId  String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  software  Software  @relation(fields: [softwareId], references: [id])

  @@id([candidateId, softwareId])
}

model WeeklyAvailabilityToken {
  id          String    @id @default(cuid())
  token       String    @unique
  candidateId String    @unique
  smsSentAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model WeeklyAvailabilityWeek {
  id          String   @id @default(cuid())
  candidateId String
  weekStart   DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  slots     WeeklyAvailabilitySlot[]

  @@unique([candidateId, weekStart])
  @@index([candidateId])
}

model WeeklyAvailabilitySlot {
  id     String                   @id @default(cuid())
  weekId String
  date   DateTime                 @db.Date
  period WeeklyAvailabilityPeriod
  week   WeeklyAvailabilityWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, date, period])
  @@index([weekId])
}

// ─── Pharmacies ───────────────────────────────────────────────

model Pharmacy {
  id                String         @id @default(cuid())
  name              String
  siret             String?        @unique
  numeroTVA         String?
  address           String?
  city              String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  phone             String?
  email             String?
  website           String?
  status            PharmacyStatus @default(PROSPECT)
  groupementId      String?
  softwareId        String?
  paymentConditions String?
  notes             String?
  referentId        String?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  groupement   Groupement?   @relation(fields: [groupementId], references: [id])
  software     Software?     @relation(fields: [softwareId], references: [id])
  referent     User?         @relation("ReferentPharmacies", fields: [referentId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  missions     Mission[]
  financeLines FinanceLine[]
  activities   ActivityLog[] @relation("PharmacyActivities")
  documents    Document[]    @relation("PharmacyDocuments")

  @@index([deletedAt])
  @@index([groupementId])
  @@index([status])
  @@index([softwareId])
  @@index([postalCode])
  @@index([referentId])
}

// ─── Contacts ─────────────────────────────────────────────────

model Contact {
  id            String    @id @default(cuid())
  pharmacyId    String
  firstName     String
  lastName      String
  email         String?
  phone         String?
  contactRoleId String
  isPrimary     Boolean   @default(false)
  notes         String?
  referentId    String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pharmacy    Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  contactRole ContactRole   @relation(fields: [contactRoleId], references: [id])
  referent    User?         @relation("ReferentContacts", fields: [referentId], references: [id], onDelete: SetNull)
  missions    Mission[]
  activities  ActivityLog[] @relation("ContactActivities")
  documents   Document[]    @relation("ContactDocuments")

  @@index([deletedAt])
  @@index([pharmacyId])
  @@index([contactRoleId])
  @@index([referentId])
}

// ─── Missions ─────────────────────────────────────────────────

model Mission {
  id               String        @id @default(cuid())
  pharmacyId       String
  contactId        String?
  referentId       String?
  jobTitleId       String
  title            String
  description      String?
  contractType     ContractType
  startDate        DateTime
  endDate          DateTime?
  status           MissionStatus @default(A_POURVOIR)
  salaireMin       Int?
  salaireMax       Int?
  salaireNotes     String?
  heuresParSemaine Float?
  planning         String?
  tempsPlein       Boolean       @default(true)
  profilRecherche  String?
  notes            String?
  marge            Float?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id])
  contact      Contact?           @relation(fields: [contactId], references: [id])
  referent     User?              @relation("ReferentMissions", fields: [referentId], references: [id], onDelete: SetNull)
  jobTitle     JobTitle           @relation(fields: [jobTitleId], references: [id])
  candidates   MissionCandidate[]
  jobOffer     JobOffer?
  activities   ActivityLog[]      @relation("MissionActivities")
  documents    Document[]         @relation("MissionDocuments")
  devis        Devis[]
  financeLines FinanceLine[]

  @@index([deletedAt])
  @@index([pharmacyId])
  @@index([referentId])
  @@index([status])
}

model Devis {
  id         String        @id @default(cuid())
  missionId  String?
  kind       DevisKind
  status     DevisStatus   @default(DRAFT)
  hours      Float?
  hourlyRate Float?
  amountHt   Float?
  amountTtc  Float?
  htSource   DevisHtSource @default(TYPED)
  sentAt     DateTime?
  acceptedAt DateTime?
  invoicedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  mission     Mission?     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  financeLine FinanceLine?

  @@index([missionId])
  @@index([deletedAt])
  @@index([status])
  @@index([sentAt])
}

model FinanceLine {
  id                    String          @id @default(cuid())
  kind                  FinanceLineKind
  pharmacyId            String
  candidateId           String
  missionId             String?
  devisId               String?         @unique
  hours                 Float?
  hourlyRate            Float?
  amountHt              Float
  htSource              DevisHtSource   @default(TYPED)
  marge                 Float?
  occurredAt            DateTime
  referentId            String?
  placementContractType ContractType?
  cancelled             Boolean         @default(false)
  invoiced              Boolean         @default(false)
  paid                  Boolean         @default(false)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
  mission   Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
  devis     Devis?    @relation(fields: [devisId], references: [id], onDelete: SetNull)
  referent  User?     @relation("ReferentFinanceLines", fields: [referentId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@index([candidateId])
  @@index([missionId])
  @@index([deletedAt])
  @@index([occurredAt])
  @@index([referentId])
}

model MissionCandidate {
  missionId   String
  candidateId String
  stageId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission   Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage     PipelineStage @relation(fields: [stageId], references: [id])

  @@id([missionId, candidateId])
  @@index([stageId])
}

// ─── Offres d'emploi ──────────────────────────────────────────

model JobOffer {
  id             String         @id @default(cuid())
  missionId      String         @unique
  title          String
  content        String
  status         JobOfferStatus @default(BROUILLON)
  boardListingId String?
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  mission      Mission       @relation(fields: [missionId], references: [id])
  applications Application[]

  @@index([deletedAt])
  @@index([status])
}

// ─── Candidatures site internet ───────────────────────────────

model Application {
  id                String            @id @default(cuid())
  jobOfferId        String
  boardSubmissionId String?           @unique
  firstName         String
  lastName          String
  email             String
  phone             String?
  city              String?
  jobTitleId        String?
  cvUrl             String?
  message           String?
  status            ApplicationStatus @default(EN_ATTENTE)
  candidateId       String?
  consentGivenAt    DateTime?
  consentSource     ConsentSource?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  jobOffer  JobOffer   @relation(fields: [jobOfferId], references: [id])
  jobTitle  JobTitle?  @relation(fields: [jobTitleId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@index([deletedAt])
  @@index([jobOfferId])
  @@index([status])
}

model AppProfile {
  id                  String           @id @default(cuid())
  badakanId           String           @unique
  firstName           String
  lastName            String
  email               String?
  phone               String?
  address             String?
  city                String?
  postalCode          String?
  activityLabel       String?
  jobTitleId          String?
  hasResume           Boolean          @default(false)
  snapshot            Json?
  status              AppProfileStatus @default(EN_ATTENTE)
  candidateId         String?
  hireflixInterviewId String?
  hireflixUrl         String?
  inviteEmailSentAt   DateTime?
  inviteLastError     String?
  syncedAt            DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  jobTitle  JobTitle?  @relation(fields: [jobTitleId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@index([status])
  @@index([candidateId])
  @@index([status, inviteEmailSentAt])
}

// ─── Historique polymorphe ────────────────────────────────────

model ActivityLog {
  id         String             @id @default(cuid())
  entityType DocumentEntityType
  authorId   String
  type       ActivityType
  content    String?
  date       DateTime           @default(now())
  createdAt  DateTime           @default(now())

  candidateId String?
  pharmacyId  String?
  contactId   String?
  missionId   String?

  author    User       @relation(fields: [authorId], references: [id])
  candidate Candidate? @relation("CandidateActivities", fields: [candidateId], references: [id])
  pharmacy  Pharmacy?  @relation("PharmacyActivities", fields: [pharmacyId], references: [id])
  contact   Contact?   @relation("ContactActivities", fields: [contactId], references: [id])
  mission   Mission?   @relation("MissionActivities", fields: [missionId], references: [id])

  @@index([candidateId])
  @@index([pharmacyId])
  @@index([contactId])
  @@index([missionId])
}

// ─── Documents polymorphes ────────────────────────────────────

model Document {
  id         String             @id @default(cuid())
  entityType DocumentEntityType
  category   DocumentCategory   @default(AUTRE)
  name       String
  url        String
  size       Int?
  mimeType   String?
  createdAt  DateTime           @default(now())

  pharmacyId  String?
  contactId   String?
  missionId   String?
  candidateId String?

  pharmacy  Pharmacy?  @relation("PharmacyDocuments", fields: [pharmacyId], references: [id])
  contact   Contact?   @relation("ContactDocuments", fields: [contactId], references: [id])
  mission   Mission?   @relation("MissionDocuments", fields: [missionId], references: [id])
  candidate Candidate? @relation("CandidateDocuments", fields: [candidateId], references: [id])

  @@index([pharmacyId])
  @@index([contactId])
  @@index([missionId])
  @@index([candidateId])
}

// ─── Interviews ───────────────────────────────────────────────

model Interview {
  id          String             @id @default(cuid())
  status      InterviewStatus    @default(DRAFT)
  mode        InterviewMode
  decision    InterviewDecision?
  answers     Json               @default("{}")
  scores      Json               @default("{}")
  candidateId String
  referentId  String?
  templateId  String?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  candidate Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  referent  User?              @relation("ReferentInterviews", fields: [referentId], references: [id], onDelete: SetNull)
  template  InterviewTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // One DRAFT per candidate: partial unique index Interview_one_draft_per_candidate
  @@index([candidateId])
  @@index([deletedAt])
  @@index([templateId])
}

model InterviewTemplate {
  id         String        @id @default(cuid())
  profileKey String
  mode       InterviewMode
  version    Int           @default(1)
  label      String
  sections   Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  interviews Interview[]

  @@unique([profileKey, mode, version])
  @@index([profileKey, mode])
}

model InterviewTemplateWorkingCopy {
  id         String        @id @default(cuid())
  profileKey String
  mode       InterviewMode
  label      String
  sections   Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?

  @@unique([profileKey, mode])
}

// ─── Audit effacement RGPD (sans PII) ─────────────────────────

// ─── Badakan missions (Intérim read cache — not CRM Mission) ──

model BadakanMission {
  id           String   @id @default(cuid())
  badakanId    String   @unique
  pharmacyName String
  step         String
  periods      Json
  syncedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  searchApplied BadakanSearchApplied[]

  @@index([step])
  @@index([syncedAt])
}

model BadakanSearchApplied {
  id               String   @id @default(cuid())
  badakanMissionId String
  recipientId      String
  firstName        String
  lastName         String
  phone            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mission BadakanMission @relation(fields: [badakanMissionId], references: [id], onDelete: Cascade)

  @@unique([badakanMissionId, recipientId])
  @@index([badakanMissionId])
}

model GdprEraseAudit {
  id             String             @id @default(cuid())
  entityType     DocumentEntityType
  entityId       String
  erasedByUserId String
  erasedAt       DateTime           @default(now())
  reason         String?

  erasedBy User @relation(fields: [erasedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([erasedAt])
}
