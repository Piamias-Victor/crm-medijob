# Database (Neon en prod, Postgres local/docker en dev)
# Local docker: postgresql://postgres:postgres@localhost:5432/medijob?schema=public
DATABASE_URL=

# NextAuth v5 — générer un secret : `openssl rand -base64 32`
# AUTH_SECRET est lu nativement par NextAuth v5 ; NEXTAUTH_SECRET reste supporté.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Idle logout (ms). Default 1800000 (30 min). Use e.g. 10000 for manual tests.
AUTH_IDLE_MS=

# Seed users — laisser vide pour les MDP par défaut (*-medijob-2026)
SEED_DIRECTION_PASSWORD=
SEED_RECRUTEUR_PASSWORD=
SEED_COMMUNICATION_PASSWORD=
SEED_RH_ADMIN_PASSWORD=
# Legacy alias (lu si SEED_RH_ADMIN_PASSWORD vide)
SEED_ADMIN_PASSWORD=
# Compte testeur perso (défaut victorpiamiaspro@gmail.com / tester-medijob-2026)
# SEED_TESTER_EMAIL=off pour désactiver
SEED_TESTER_EMAIL=
SEED_TESTER_PASSWORD=

# Assistant IA / extraction — provider abstrait (SPEC_V2 §7), via OpenRouter
# EXTRACTION_PROVIDER=mock → réponses simulées, aucune clé requise (tests / dev)
# Sinon (toute autre valeur) → OpenRouter si OPENROUTER_API_KEY est défini, sinon fallback mock
EXTRACTION_PROVIDER=mock
OPENROUTER_API_KEY=
# Modèle OpenRouter (défaut : google/gemini-2.5-flash-lite)
EXTRACTION_MODEL=google/gemini-2.5-flash-lite

# Vercel Blob — documents (pharmacies, missions, etc.)
BLOB_READ_WRITE_TOKEN=

# Badakan — sync lecture « Profils app » (nouveaux inscrits)
BADAKAN_EMAIL=
BADAKAN_PASSWORD=
# Optionnel (défaut https://api.badakan.com/brother-web)
BADAKAN_API_URL=
BADAKAN_BASE_URL=

