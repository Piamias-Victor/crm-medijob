# Database (Neon en prod, Postgres local/docker en dev)
# Local docker: postgresql://postgres:postgres@localhost:5432/medijob?schema=public
DATABASE_URL=

# NextAuth v5 — générer un secret : `openssl rand -base64 32`
# AUTH_SECRET est lu nativement par NextAuth v5 ; NEXTAUTH_SECRET reste supporté.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Idle logout (ms). Default 1800000 (30 min). Use e.g. 10000 for manual tests.
AUTH_IDLE_MS=

# Seed users — laisser vide pour les MDP par défaut (*-medijob-2026)
SEED_DIRECTION_PASSWORD=
SEED_RECRUTEUR_PASSWORD=
SEED_COMMUNICATION_PASSWORD=
SEED_RH_ADMIN_PASSWORD=
# Legacy alias (lu si SEED_RH_ADMIN_PASSWORD vide)
SEED_ADMIN_PASSWORD=
# Compte testeur perso (défaut victorpiamiaspro@gmail.com / tester-medijob-2026)
# SEED_TESTER_EMAIL=off pour désactiver
SEED_TESTER_EMAIL=
SEED_TESTER_PASSWORD=

# Local: auto-login Testeur MediJob. AUTH_DEV_AUTO_LOGIN=off pour forcer le formulaire.
# Jamais actif en production.
AUTH_DEV_AUTO_LOGIN=

# Assistant IA / extraction — provider abstrait (SPEC_V2 §7), via OpenRouter
# EXTRACTION_PROVIDER=mock → réponses simulées, aucune clé requise (tests / dev)
# Sinon (toute autre valeur) → OpenRouter si OPENROUTER_API_KEY est défini, sinon fallback mock
EXTRACTION_PROVIDER=mock
OPENROUTER_API_KEY=
# Modèle OpenRouter (défaut : google/gemini-2.5-flash-lite)
EXTRACTION_MODEL=google/gemini-2.5-flash-lite

# Vercel Blob — documents (pharmacies, missions, etc.) — legacy tant que S3_DOCUMENTS_BUCKET vide
BLOB_READ_WRITE_TOKEN=

# S3 documents (prod AWS / hybrid Vercel). Si défini → remplace Vercel Blob.
# S3_DOCUMENTS_BUCKET=medijob-prod-docs-xxxxx
# S3_DOCUMENTS_REGION=eu-west-3
# Sur Vercel : IAM keys (tofu output vercel_aws_*) — SDK default chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BLOB_DRIVER=memory  # tests locaux sans S3/Vercel

# Resend — reset mot de passe (obligatoire en prod, jamais logger le token)
RESEND_API_KEY=
RESEND_FROM=MediJob <recrutement@send.medijob.fr>

# Vercel Cron (ingest candidatures site, toutes les heures)
CRON_SECRET=
# Interrupteur global des crons. Off par défaut : seul `true` les autorise à tourner.
CRON_ENABLED=

# Job board public (medijob-offres) — ne jamais committer les vraies clés
JOBS_SITE_URL=https://medijob-offres.netlify.app
JOBS_SUPABASE_URL=
JOBS_SUPABASE_PUBLISHABLE_KEY=
JOBS_SUPABASE_SECRET_KEY=
JOBS_CONTACT_EMAIL=

# Badakan — sync lecture « Profils app » (nouveaux inscrits)
BADAKAN_EMAIL=
BADAKAN_PASSWORD=
# Optionnel (défaut https://api.badakan.com/brother-web)
BADAKAN_API_URL=
BADAKAN_BASE_URL=

# Hireflix + Brevo — invitation vidéo des Profils app (cron 2 min)
HIREFLIX_API_KEY=
HIREFLIX_POSITION_ID=
BREVO_API_KEY=
BREVO_SENDER=
BREVO_TEMPLATE_ID=
# Sender SMS Brevo (3–11 alphanum) — expéditeur du lien dispos
BREVO_SMS_SENDER=
# Phase de test : override Hireflix + Brevo, 1 profil / run. Vide = prod (ne pas setter sur Vercel).
HIREFLIX_INVITE_TEST_TO=
# Lien dispos App-validated : numéro test qui reçoit tous les SMS. Vide = téléphone du Candidate.
# Requis pour le bouton « Tester le process » d'une fiche Profil app.
AVAILABILITY_LINK_TEST_PHONE=

